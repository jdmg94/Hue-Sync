{
  "name": "hue-sync",
  "version": "0.2.0",
  "description": "A Library for Phillips Hue Clip API v2 written in Typescript",
  "main": "build/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "prettier -w src",
    "build": "vite build",
    "publish": "npm run build && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdmg94/Hue-Sync.git"
  },
  "author": "José Muñoz",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/jdmg94/Hue-Sync/issues"
  },
  "homepage": "https://github.com/jdmg94/Hue-Sync",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/ui": "^4.0.15",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "node-dns-sd": "^1.0.1",
    "node-dtls-client": "^1.1.1"
  }
}
